{
  "name": "bluecheese",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bc": "tsx packages/cli/src/main.ts",
    "slots": "tsx packages/agent/scripts/slots-test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter bluecheese-vscode exec tsc -p tsconfig.json",
    "build:ext": "pnpm --filter bluecheese-vscode build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
